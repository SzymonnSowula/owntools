# owntools landing (web/) — public configuration.
# Every variable is optional: an unset one makes the site render an honest
# "not yet" state instead of a dead link. Copy to web/.env.local to use.

# Canonical origin of the website (metadataBase, sitemap, robots, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://owntools.app

# Direct link to the Windows installer (a GitHub release asset). Leave unset
# until the first release ships — the download buttons then read
# "windows build — launching soon".
NEXT_PUBLIC_DOWNLOAD_URL_WINDOWS=

# Direct link to the macOS .dmg (universal: Apple Silicon + Intel). Leave
# unset until the first macOS release ships — the button then reads
# "mac build — launching soon" instead of pointing nowhere.
NEXT_PUBLIC_DOWNLOAD_URL_MACOS=

# Polar.sh checkout link for the Pro key. Unset → "checkout opens on launch day".
NEXT_PUBLIC_CHECKOUT_URL=

# Support and legal contact address (mailto: links, legal pages, refunds).
NEXT_PUBLIC_CONTACT_EMAIL=

# Profile on X. The "ask on x" card and the footer link render only when set.
NEXT_PUBLIC_X_URL=

# Public source repository (footer "github" link).
NEXT_PUBLIC_REPO_URL=https://github.com/SzymonnSowula/owntools

# Plausible analytics data-domain (e.g. owntools.app). Unset → no analytics script at all.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Operator shown on /privacy, /terms and /refunds: legal name and postal address.
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_LEGAL_ADDRESS=

# PRICE is hardcoded in web/lib/site.ts (currently $49; the business plan says
# 149 zł — decide before launch).

# --- Share links (screeni → "Create share link") -----------------------------
# The desktop app uploads exported videos into an S3-compatible bucket
# (Cloudflare R2, MinIO, AWS S3) through presigned multipart URLs, and the
# site serves them at /v/<id>. Leave these unset and the app shows
# "sharing isn't switched on yet" instead of a broken upload.
# R2 endpoint looks like https://<account-id>.r2.cloudflarestorage.com
SHARE_S3_ENDPOINT=
SHARE_S3_BUCKET=
# "auto" for R2; the AWS region name for S3.
SHARE_S3_REGION=auto
SHARE_S3_ACCESS_KEY_ID=
SHARE_S3_SECRET_ACCESS_KEY=
# Optional public base URL of the bucket (R2 public bucket / custom domain / CDN).
# Without it the player page presigns a one-hour GET for every view.
SHARE_PUBLIC_BASE=
# Upload cap per video in MB (default 500) and link lifetime in days (default 30, 0 = keep forever).
SHARE_MAX_MB=500
SHARE_TTL_DAYS=30
# The uploads go straight from the app to the bucket; no bucket CORS rule is
# needed because the app sends them from its native HTTP client, not the webview.
