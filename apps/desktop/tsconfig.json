{
  "compilerOptions": {
    "target": "ES2021",
    "useDefineForClassFields": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "baseUrl": ".",
    "paths": {
      "@ui/*": ["../../packages/ui/src/*"],
      "@core/*": ["../../packages/core/src/*"],
      "@licensing/*": ["../../packages/licensing/src/*"],
      "@feature-focus/*": ["../../packages/feature-focus/src/*"],
      "@feature-recorder/*": ["../../packages/feature-recorder/src/*"],
      "@feature-editor/*": ["../../packages/feature-editor/src/*"],
      "@feature-launch/*": ["../../packages/feature-launch/src/*"],
      "@feature-dictation/*": ["../../packages/feature-dictation/src/*"],
      "@feature-board/*": ["../../packages/feature-board/src/*"],
      "@feature-social/*": ["../../packages/feature-social/src/*"],
      "@feature-tools/*": ["../../packages/feature-tools/src/*"],
      "@feature-disk/*": ["../../packages/feature-disk/src/*"],
      "@feature-meet/*": ["../../packages/feature-meet/src/*"],
      "@feature-capture/*": ["../../packages/feature-capture/src/*"],
      "@feature-automations/*": ["../../packages/feature-automations/src/*"],
      "@feature-sync/*": ["../../packages/feature-sync/src/*"],
      "@feature-privacy/*": ["../../packages/feature-privacy/src/*"],
      "@feature-llm/*": ["../../packages/feature-llm/src/*"]
    }
  },
  "include": ["src", "../../packages/*/src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
