{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "owntools",
  "version": "0.2.0",
  "identifier": "app.owntools.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "owntools",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "visible": true,
        "dragDropEnabled": false
      },
      {
        "label": "recorder",
        "title": "owntools recorder",
        "url": "overlay.html",
        "width": 460,
        "height": 700,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "decorations": false,
        "shadow": true,
        "visible": false
      },
      {
        "label": "dictation",
        "title": "owntools dictation",
        "url": "dictation.html",
        "width": 320,
        "height": 76,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "focus": false,
        "focusable": false,
        "visible": false
      },
      {
        "label": "captions",
        "title": "owntools captions",
        "url": "captions.html",
        "width": 920,
        "height": 150,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "focus": false,
        "focusable": false,
        "visible": false
      },
      {
        "label": "capture",
        "title": "owntools capture",
        "url": "capture.html",
        "width": 800,
        "height": 600,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost blob: asset: http://asset.localhost; media-src 'self' blob: asset: http://asset.localhost; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$VIDEO/**",
          "$DOWNLOAD/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "English"
        ],
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1RDU4RjI1NTBBNTkxODMKUldTRGthVlFKWS9WZFREZDV1UlNGb1ZEc2JRQS9GMmJXK2IvUXJtbnp5WHcyc09iZlZzWER5RlUK",
      "endpoints": [
        "https://github.com/SzymonnSowula/owntools/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
